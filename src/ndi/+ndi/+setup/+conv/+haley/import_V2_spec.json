   "key": "large_single_patch",
   "name": "Large, single-patch assay",
   "short_name": "foragingConcentration (single)",
   "source_folder": "foragingConcentration",
   "source_condition": "single",
   "description": "As the single-density multi-patch assay, but one large 20 µl patch in the centre of the 30 mm arena.",
   "factors": [
    {
     "node": "",
     "name": "OD600"
    }
   ]
  },
  {
   "key": "small_single_patch",
   "name": "Small, single-patch assay",
   "short_name": "foragingMini",
   "source_folder": "foragingMini",
   "description": "One young adult in a 9 mm arena with one 0.5 µl patch (OD600 0, 0.5, 1, 5, 10); 1 h at 8 fps and ~105 px/mm, head and tail tracked.",
   "factors": [
    {
     "node": "",
     "name": "OD600"
    }
   ]
  },
  {
   "key": "multi_density_multi_patch",
