 "studies": [
  {
   "key": "single_density_multi_patch",
   "name": "Single-density, multi-patch assay",
   "short_name": "foragingConcentration (grid)",
   "source_folder": "foragingConcentration",
   "source_condition": "grid",
   "description": "Four young adult hermaphrodites forage in a 30 mm arena on an isometric grid of 19 patches (0.5 µl, 6 mm apart), all of one OP50 density (OD600 0-10; also 1 (12H) and 1 (48H) grown patches); 1 h at 3 fps.",
   "factors": [
    {
     "node": "",
     "name": "OD600"
    },
    {
     "node": "",
     "name": "bacterial growth time"
    }
   ]
  },
